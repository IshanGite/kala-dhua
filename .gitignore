/data/
*.db
*.db-wal
*.db-shm
*.enc
.env
.env.*
secrets/
canary/

# models and weights are never committed
*.gguf
*.safetensors
*.bin

# per-machine generated files
profile.toml
reports/
.DS_Store
Thumbs.db
